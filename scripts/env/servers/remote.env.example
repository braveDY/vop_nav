# Copy to remote.env, then edit paths for the remote host.
# REMOTE_HOST must be a working SSH alias or user@host.
export CONNECTION_MODE="ssh"
export REMOTE_HOST="your-ssh-alias"
export REMOTE_RUNTIME="conda"
export REMOTE_DIR="${REMOTE_DIR:-/path/to/vop_nav}"
export REMOTE_CONDA_ROOT="${REMOTE_CONDA_ROOT:-/path/to/miniconda3}"
export REMOTE_CONDA_ENV="${REMOTE_CONDA_ENV:-${REMOTE_CONDA_ROOT}/envs/isaaclab}"
export REMOTE_PYTHON="${REMOTE_CONDA_ENV}/bin/python"
export REMOTE_STREAM_IP="${REMOTE_STREAM_IP_OVERRIDE:-127.0.0.1}"
export TB_PORT="${REMOTE_TB_PORT:-16086}"
export LIVESTREAM_PORT="${REMOTE_STREAM_PORT:-49100}"
