# Copy to <name>.env, replace paths, then source env.sh --server <name>.
export CONNECTION_MODE="ssh"
export REMOTE_HOST="your-ssh-alias"
export REMOTE_RUNTIME="conda"
export REMOTE_DIR="/home/your-user/projects/vop_nav"
export REMOTE_CONDA_ROOT="/home/your-user/miniconda3"
export REMOTE_CONDA_ENV="${REMOTE_CONDA_ROOT}/envs/isaaclab"
export REMOTE_PYTHON="${REMOTE_CONDA_ENV}/bin/python"
export REMOTE_STREAM_IP="127.0.0.1"
export TB_PORT="16086"
export LIVESTREAM_PORT="49100"
