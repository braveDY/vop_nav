# Local Conda runtime. Override LOCAL_CONDA_ROOT and LOCAL_CONDA_ENV as needed.
export CONNECTION_MODE="local"
export REMOTE_HOST="localhost"
export REMOTE_RUNTIME="conda"
export REMOTE_DIR="${PROJECT_ROOT}"
export REMOTE_CONDA_ROOT="${LOCAL_CONDA_ROOT:-${HOME}/miniconda3}"
export REMOTE_CONDA_ENV="${LOCAL_CONDA_ENV:-${REMOTE_CONDA_ROOT}/envs/isaaclab}"
export REMOTE_PYTHON="${REMOTE_CONDA_ENV}/bin/python"
export TB_PORT="${LOCAL_TB_PORT:-16086}"
